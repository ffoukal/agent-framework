#!/usr/bin/env bash
# agent-task-check — validate the protocol for a task. Final step of shutdown.
# Exit code != 0 with clear messages if anything fails.
set -eu

case "${1:-}" in
  -h|--help)
    echo "Usage: agent-task-check [TASK-ID]"
    echo "Validates protocol invariants for the task (config, progress frontmatter,"
    echo "Next section, Recent log, commit flow, close/resume). Exit != 0 on any failure."
    echo "If TASK-ID is omitted, uses .agents/tasks/.current."
    exit 0
    ;;
esac

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
AGENTS_DIR=$(dirname "$SCRIPT_DIR")

resolve_task() {
  if [ -n "${1:-}" ]; then
    printf '%s' "$1"
  elif [ -f "$AGENTS_DIR/tasks/.current" ]; then
    tr -d '[:space:]' < "$AGENTS_DIR/tasks/.current"
  fi
}

TASK_ID=$(resolve_task "${1:-}")
if [ -z "$TASK_ID" ]; then
  echo "FAIL: no task id given and .agents/tasks/.current is empty" >&2
  exit 2
fi
case "$TASK_ID" in
  .*|*[!A-Za-z0-9._-]*)
    echo "FAIL: invalid task id '$TASK_ID' (letters/digits/._- only, no slashes)" >&2
    exit 2 ;;
esac

TASK_DIR="$AGENTS_DIR/tasks/$TASK_ID"
CONFIG="$AGENTS_DIR/project/config.yml"
REPO_ROOT=$(dirname "$AGENTS_DIR")

ERRORS=0
fail() { echo "FAIL: $1" >&2; ERRORS=$((ERRORS + 1)); }
warn() { echo "WARN: $1" >&2; }

# --- config.yml ------------------------------------------------------------
MODE=""
if [ ! -f "$CONFIG" ]; then
  fail "$CONFIG does not exist"
else
  MODE=$(grep -E '^[[:space:]]*mode:' "$CONFIG" | head -1 \
    | sed 's/#.*//' | sed 's/.*mode:[[:space:]]*//' | awk '{print $1}')
  case "$MODE" in
    human-gated|agent) : ;;
    "") fail "config.yml has no commits.mode" ;;
    *) fail "config.yml commits.mode '$MODE' is invalid (want human-gated|agent)" ;;
  esac

  # models.mapping: the three tiers must be present
  for _tier in reasoning standard fast; do
    grep -qE "^[[:space:]]*$_tier:[[:space:]]*\{" "$CONFIG" \
      || fail "config.yml models.mapping is missing tier '$_tier'"
  done

  # models.agents: every framework agent must have a valid tier + effort
  AGENTS_DIR2="$AGENTS_DIR/agents"
  if [ -d "$AGENTS_DIR2" ]; then
    for _af in "$AGENTS_DIR2"/*.md; do
      [ -f "$_af" ] || continue
      _agent=$(basename "$_af" .md)
      _line=$(grep -E "^[[:space:]]*$_agent:[[:space:]]*\{" "$CONFIG" | head -1)
      if [ -z "$_line" ]; then
        fail "config.yml models.agents has no entry for agent '$_agent'"
        continue
      fi
      _t=$(printf '%s' "$_line" | sed -nE 's/.*tier:[[:space:]]*([A-Za-z]+).*/\1/p')
      _e=$(printf '%s' "$_line" | sed -nE 's/.*effort:[[:space:]]*([A-Za-z]+).*/\1/p')
      case "$_t" in reasoning|standard|fast) : ;; *)
        fail "config.yml models.agents.$_agent has invalid tier '$_t'" ;; esac
      case "$_e" in high|medium|low) : ;; *)
        fail "config.yml models.agents.$_agent has invalid effort '$_e'" ;; esac
    done
  fi
fi

# --- .agents/tasks must be gitignored --------------------------------------
if git -C "$REPO_ROOT" rev-parse --git-dir >/dev/null 2>&1; then
  if ! git -C "$REPO_ROOT" check-ignore -q .agents/tasks 2>/dev/null; then
    warn ".agents/tasks/ is not gitignored — add '.agents/tasks/' to .gitignore (local working state)"
  fi
fi

# --- task dir --------------------------------------------------------------
if [ ! -d "$TASK_DIR" ]; then
  fail "task $TASK_ID not found at $TASK_DIR"
  echo "$ERRORS error(s)." >&2
  exit 1
fi

TASK="$TASK_DIR/task.md"
PROGRESS="$TASK_DIR/progress.md"

# --- progress.md frontmatter -----------------------------------------------
STATUS="" ; TYPE="" ; PHASE="" ; BASE_COMMIT=""
if [ ! -f "$PROGRESS" ]; then
  fail "progress.md missing"
else
  # extract frontmatter (between the first two --- lines)
  FM=$(awk 'NR==1 && $0!="---"{exit} /^---[[:space:]]*$/{c++; next} c==1{print} c==2{exit}' "$PROGRESS")
  if [ -z "$FM" ]; then
    fail "progress.md frontmatter not parseable (missing --- delimiters)"
  else
    get() { printf '%s\n' "$FM" | grep -E "^[[:space:]]*$1:" | head -1 \
      | sed "s/#.*//" | sed "s/.*$1:[[:space:]]*//" | awk '{print $1}'; }
    STATUS=$(get status)
    TYPE=$(get type)
    PHASE=$(get phase)
    BASE_COMMIT=$(get base_commit)

    case "$STATUS" in
      READY|IN_PROGRESS|AWAITING_COMMIT|NEEDS_HUMAN|BLOCKED|CHANGES_REQUESTED|APPROVED|DONE) : ;;
      *) fail "progress.md status '$STATUS' is invalid" ;;
    esac
    case "$TYPE" in
      feature|fix|debug|chore|spike) : ;;
      *) fail "progress.md type '$TYPE' is invalid" ;;
    esac
    case "$PHASE" in
      intake|spec|diagnose|explore|plan|implement|test|review|security-review|split|release) : ;;
      *) fail "progress.md phase '$PHASE' is invalid" ;;
    esac

    # updated timestamp quality (manual creation often zeroes or leaves it)
    UPDATED=$(get updated)
    case "$UPDATED" in
      *T00:00:00Z) warn "progress.md 'updated' time is zeroed ($UPDATED) — likely not a real timestamp" ;;
    esac
  fi
fi

# --- unreplaced template placeholders --------------------------------------
for _pf in task.md progress.md; do
  _file="$TASK_DIR/$_pf"
  [ -f "$_file" ] || continue
  if grep -qE 'TASK-000|<TASK_ID>|<ISO-8601( UTC)?>|<sha>' "$_file"; then
    fail "$_pf still contains an unreplaced template placeholder (use agent-task-new)"
  fi
done

[ -f "$TASK" ] || fail "task.md missing"

# --- ## Next section -------------------------------------------------------
if [ -f "$PROGRESS" ]; then
  NEXT_SECTION=$(awk '/^## Next[[:space:]]*$/{f=1; next} f && /^## /{exit} f{print}' "$PROGRESS")
  if [ -z "$(printf '%s' "$NEXT_SECTION" | tr -d '[:space:]')" ]; then
    fail "progress.md '## Next' section is empty"
  elif [ -f "$CONFIG" ]; then
    # the agent named under "### Agent to use" should exist in config.yml models.agents
    NEXT_AGENT=$(printf '%s\n' "$NEXT_SECTION" | awk '
      /^### Agent to use/ { f=1; next }
      f {
        if ($0 ~ /<!--/) inc=1
        if (inc) { if ($0 ~ /-->/) inc=0; next }
        if ($0 ~ /^### /) exit
        if ($0 ~ /^[[:space:]]*$/) next
        print; exit
      }' | sed -E 's/^[^A-Za-z]*//; s/[^A-Za-z0-9-].*$//')
    if [ -n "$NEXT_AGENT" ] && [ "$NEXT_AGENT" != "None" ] && [ "$NEXT_AGENT" != "none" ]; then
      grep -qE "^[[:space:]]*$NEXT_AGENT:[[:space:]]*\{" "$CONFIG" \
        || warn "progress.md 'Agent to use' names '$NEXT_AGENT', not found in config.yml models.agents"
    fi
  fi
fi

# --- Recent log ------------------------------------------------------------
LOG_ENTRIES=0
if [ -f "$PROGRESS" ]; then
  LOG_ENTRIES=$(awk '/^## Recent log[[:space:]]*$/{f=1; next} f && /^## /{exit} f && /^### /{n++} END{print n+0}' "$PROGRESS")
  if [ "$LOG_ENTRIES" -lt 1 ]; then
    fail "progress.md Recent log has no entries (expected at least one after doing work)"
  elif [ "$LOG_ENTRIES" -gt 7 ]; then
    fail "progress.md Recent log has $LOG_ENTRIES entries — keep only the last ~5 (drop the oldest)"
  elif [ "$LOG_ENTRIES" -gt 5 ]; then
    warn "progress.md Recent log has $LOG_ENTRIES entries — trim to the last ~5 (drop the oldest)"
  fi
fi

# --- progress.md size cap (context budget: sections are overwritten, not appended) --
if [ -f "$PROGRESS" ]; then
  P_LINES=$(wc -l < "$PROGRESS" | tr -d ' ')
  if [ "$P_LINES" -gt 120 ]; then
    fail "progress.md is $P_LINES lines (cap 120) — ## Next and ## Commit request are overwritten in place, Recent log keeps ~5 entries; move any narrative to task.md"
  elif [ "$P_LINES" -gt 90 ]; then
    warn "progress.md is $P_LINES lines — trim toward the template shape (~50 lines + content)"
  fi
fi

# --- Commit request section invariants -------------------------------------
if [ -f "$PROGRESS" ]; then
  CR_SECTION=$(awk '/^## Commit request[[:space:]]*$/{f=1; next} f && /^## /{exit} f{print}' "$PROGRESS" \
    | sed '/<!--/,/-->/d')
  CR_EMPTY=1
  if [ -n "$(printf '%s' "$CR_SECTION" | tr -d '[:space:]')" ] \
     && ! printf '%s\n' "$CR_SECTION" | grep -qiE '^[[:space:]]*None\.?[[:space:]]*$'; then
    # section has real content beyond "None."
    CR_CONTENT=$(printf '%s\n' "$CR_SECTION" | grep -vE '^[[:space:]]*None\.?[[:space:]]*$' | tr -d '[:space:]')
    [ -n "$CR_CONTENT" ] && CR_EMPTY=0
  fi
  if [ "$STATUS" = "AWAITING_COMMIT" ]; then
    if [ "$MODE" = "agent" ]; then
      fail "status AWAITING_COMMIT is only valid in human-gated mode"
    fi
    if [ "$CR_EMPTY" -eq 1 ]; then
      fail "status AWAITING_COMMIT but the progress.md '## Commit request' section is empty"
    fi
  else
    if [ "$CR_EMPTY" -eq 0 ]; then
      fail "progress.md '## Commit request' has content but status is '$STATUS' — reset it to 'None.' after the commit is confirmed"
    fi
  fi
fi

# --- feature list invariants (WIP=1, evidence) -----------------------------
# Delegated to agent-plan so the rules live in exactly one place. Only features have
# a plan file; everything else has nothing to check.
if [ "$TYPE" = "feature" ] && [ -x "$SCRIPT_DIR/agent-plan" ]; then
  if grep -qE '^plan:[[:space:]]*[^[:space:]]' "$TASK" 2>/dev/null \
     && ! grep -qE '^plan:[[:space:]]*(null|~)?[[:space:]]*$' "$TASK" 2>/dev/null; then
    PLAN_OUT=$("$SCRIPT_DIR/agent-plan" check "$TASK_ID" 2>&1) || {
      printf '%s\n' "$PLAN_OUT" >&2
      fail "plan Tasks violate the feature-list invariants (see above)"
    }
  fi
fi

# --- runtime verification evidence at review/close -------------------------
# APPROVED/DONE without a "Verified:" line means the verdict rests on reading a diff.
if [ -f "$TASK" ]; then
  case "$STATUS" in
    APPROVED|DONE)
      case "$TYPE" in
        feature|fix|chore)
          grep -qiE '^[[:space:]]*Verified:' "$TASK" \
            || warn "task.md has no 'Verified: <level> — <result>' line but status is $STATUS — an APPROVED verdict should name the verification that actually ran (agent-verify quick|full|e2e), or 'UNAVAILABLE'"
          ;;
      esac ;;
  esac
fi

# --- harness readiness (cheap, advisory) -----------------------------------
if [ -x "$SCRIPT_DIR/agent-env-check" ]; then
  ENV_OUT=$("$SCRIPT_DIR/agent-env-check" --quiet 2>&1) || {
    printf '%s\n' "$ENV_OUT" | sed 's/^/  /' >&2
    warn "harness gaps above — they are paid back on every task until closed"
  }
fi

# --- split-plan approval gate ---------------------------------------------
SP="$TASK_DIR/split-plan.md"
if [ -f "$SP" ]; then
  SP_APPROVED=$(grep -E '^[[:space:]]*approved_by_human:' "$SP" | head -1 \
    | sed 's/.*approved_by_human:[[:space:]]*//' | awk '{print $1}')
  if [ "$SP_APPROVED" = "false" ] && [ "$STATUS" != "NEEDS_HUMAN" ]; then
    fail "split-plan.md approved_by_human: false but status is '$STATUS' (must stay NEEDS_HUMAN until approved)"
  fi
fi

# --- DONE: durable resume + INDEX line -------------------------------------
if [ "$STATUS" = "DONE" ]; then
  case "$TYPE" in
    fix|chore|feature)
      RESUME=$(grep -rlE "^task:[[:space:]]*$TASK_ID" "$REPO_ROOT/docs/tasks/" 2>/dev/null | head -1)
      if [ -z "$RESUME" ]; then
        fail "status DONE but no resume in docs/tasks/ has 'task: $TASK_ID' frontmatter"
      else
        HG=$(grep -E '^harness_gap:' "$RESUME" | head -1 | sed 's/^harness_gap:[[:space:]]*//' \
             | sed 's/#.*//' | awk '{print $1}')
        case "$HG" in
          none|spec|context|env|feedback|state) : ;;
          "") warn "resume $(basename "$RESUME") has no 'harness_gap:' — one word (none|spec|context|env|feedback|state); it is how the harness's own bottleneck becomes visible" ;;
          *) fail "resume $(basename "$RESUME") has invalid harness_gap '$HG' (want none|spec|context|env|feedback|state)" ;;
        esac
      fi
      if [ -f "$REPO_ROOT/docs/tasks/INDEX.md" ]; then
        grep -q "$TASK_ID" "$REPO_ROOT/docs/tasks/INDEX.md" \
          || fail "status DONE but docs/tasks/INDEX.md has no line for $TASK_ID"
      else
        fail "status DONE but docs/tasks/INDEX.md does not exist"
      fi
      ;;
  esac
fi

# --- adapter drift (config.yml edited but adapters not regenerated) --------
CLAUDE_AGENTS="$REPO_ROOT/.claude/agents"
if [ -f "$CONFIG" ] && [ -d "$CLAUDE_AGENTS" ]; then
  NEWEST_ADAPTER=$(ls -t "$CLAUDE_AGENTS"/*.md 2>/dev/null | head -1)
  if [ -n "$NEWEST_ADAPTER" ] && [ "$CONFIG" -nt "$NEWEST_ADAPTER" ]; then
    warn "config.yml is newer than the generated adapters — run .agents/scripts/agent-models-sync to apply the new tiers"
  fi
fi

# --- agent-mode commit correspondence -------------------------------------
if [ "$MODE" = "agent" ] && [ -n "$BASE_COMMIT" ] && [ "$BASE_COMMIT" != "none" ] && [ -f "$PROGRESS" ]; then
  if git rev-parse --git-dir >/dev/null 2>&1; then
    if git cat-file -e "$BASE_COMMIT^{commit}" 2>/dev/null; then
      for sha in $(git rev-list "$BASE_COMMIT"..HEAD 2>/dev/null); do
        short=$(git rev-parse --short=7 "$sha")
        if ! grep -q "$short" "$PROGRESS" 2>/dev/null && ! grep -q "$sha" "$PROGRESS" 2>/dev/null; then
          fail "commit $short is not recorded in the progress.md Recent log (agent mode)"
        fi
        if git log -1 --format='%B' "$sha" | grep -iqE 'co-authored-by:|generated with|🤖'; then
          fail "commit $short has a forbidden AI co-authorship/attribution trailer"
        fi
      done
    else
      warn "base_commit $BASE_COMMIT not found in git history; skipping commit checks"
    fi
  fi
fi

if [ "$ERRORS" -eq 0 ]; then
  echo "OK: task $TASK_ID passes protocol checks (mode=$MODE, status=$STATUS)."
  exit 0
else
  echo "$ERRORS error(s) found for task $TASK_ID." >&2
  exit 1
fi
