#!/usr/bin/env bash
# agent-task-current — print the active task id (or nothing if none).
set -eu

case "${1:-}" in
  -h|--help)
    echo "Usage: agent-task-current"
    echo "Prints the active task id from .agents/tasks/.current (empty if none)."
    exit 0
    ;;
esac

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
AGENTS_DIR=$(dirname "$SCRIPT_DIR")
CURRENT="$AGENTS_DIR/tasks/.current"

if [ -f "$CURRENT" ]; then
  tr -d '[:space:]' < "$CURRENT"
  echo
fi
