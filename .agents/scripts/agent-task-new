#!/usr/bin/env bash
# agent-task-new — create a new task from templates.
set -eu

usage() {
  cat <<'EOF'
Usage: agent-task-new TASK-ID "Goal"

Creates .agents/tasks/TASK-ID/ with task.md and progress.md from templates,
registers base_commit = current HEAD, and sets tasks/.current.
Errors (without overwriting) if the task already exists.

Low-level primitive: the documented entry point for new work is the intake agent
("Start a new task using the persistent agent system."). The intake prunes the
task.md sections that do not apply to the task type after creation.
EOF
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
esac

TASK_ID="${1:-}"
GOAL="${2:-}"
if [ -z "$TASK_ID" ] || [ -z "$GOAL" ]; then
  usage >&2
  exit 2
fi

# Validate the task id before it touches any path or sed expression.
# Allowed: letters/digits/._- ; no slashes (path traversal); not starting with '.'.
case "$TASK_ID" in
  .*|*[!A-Za-z0-9._-]*)
    echo "error: invalid task id '$TASK_ID'" >&2
    echo "  allowed: letters, digits, '.', '_', '-'; no slashes; not starting with '.'" >&2
    exit 2 ;;
esac

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
AGENTS_DIR=$(dirname "$SCRIPT_DIR")
TEMPLATES="$AGENTS_DIR/templates"
TASK_DIR="$AGENTS_DIR/tasks/$TASK_ID"

if [ -e "$TASK_DIR" ]; then
  echo "error: task $TASK_ID already exists at $TASK_DIR (not overwriting)" >&2
  exit 1
fi

NOW=$(date -u +%Y-%m-%dT%H:%M:%SZ)
BASE_COMMIT=$(git rev-parse HEAD 2>/dev/null || echo "none")

mkdir -p "$TASK_DIR"
for f in task.md progress.md; do
  cp "$TEMPLATES/$f" "$TASK_DIR/$f"
done

for f in task.md progress.md; do
  file="$TASK_DIR/$f"
  sed \
    -e "s/TASK-000/$TASK_ID/g" \
    -e "s/<TASK_ID>/$TASK_ID/g" \
    -e "s|<ISO-8601 UTC>|$NOW|g" \
    -e "s|<ISO-8601>|$NOW|g" \
    -e "s|<sha>|$BASE_COMMIT|g" \
    "$file" > "$file.tmp" && mv "$file.tmp" "$file"
done

file="$TASK_DIR/task.md"
awk -v goal="$GOAL" '
  { print }
  !done && $0 == "## Goal" { print goal; done=1 }
' "$file" > "$file.tmp" && mv "$file.tmp" "$file"

# Seed the Recent log so the task is valid from birth (agent-task-check requires an entry).
printf '\n### %s | agent-task-new | - | %s\n- Task created from templates.\n' \
  "$NOW" "$(git rev-parse --short HEAD 2>/dev/null || echo none)" >> "$TASK_DIR/progress.md"

printf '%s\n' "$TASK_ID" > "$AGENTS_DIR/tasks/.current"

echo "Created task $TASK_ID"
echo "  dir:         $TASK_DIR"
echo "  base_commit: $BASE_COMMIT"
echo "  current task (.agents/tasks/.current) set to $TASK_ID"
echo "Next: prune task.md to the task type, then invoke the task-protocol skill (or run /task)."
