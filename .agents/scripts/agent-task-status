#!/usr/bin/env bash
# agent-task-status — print progress.md and the task.md brief for a task.
set -eu

case "${1:-}" in
  -h|--help)
    echo "Usage: agent-task-status [TASK-ID]"
    echo "       agent-task-status --all"
    echo "Prints progress.md (state, Next, Recent log) and the task.md brief."
    echo "With --all (or --list): one line per task — id | type | status | phase | updated."
    echo "If TASK-ID is omitted, uses .agents/tasks/.current."
    exit 0
    ;;
esac

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
AGENTS_DIR=$(dirname "$SCRIPT_DIR")

# --- --all / --list : overview of every task ------------------------------
case "${1:-}" in
  --all|--list)
    CURRENT=""
    [ -f "$AGENTS_DIR/tasks/.current" ] && CURRENT=$(tr -d '[:space:]' < "$AGENTS_DIR/tasks/.current")
    printf '%-16s %-8s %-16s %-14s %-20s %s\n' TASK TYPE STATUS PHASE UPDATED ''
    for _d in "$AGENTS_DIR"/tasks/*/; do
      [ -d "$_d" ] || continue
      _id=$(basename "$_d")
      _s="$_d/progress.md"
      _fld() { grep -E "^[[:space:]]*$1:" "$_s" 2>/dev/null | head -1 \
        | sed 's/#.*//' | sed "s/.*$1:[[:space:]]*//" | awk '{print $1}'; }
      _mark=''; [ "$_id" = "$CURRENT" ] && _mark='*'
      printf '%-16s %-8s %-16s %-14s %-20s %s\n' \
        "$_id" "$(_fld type)" "$(_fld status)" "$(_fld phase)" "$(_fld updated)" "$_mark"
    done
    echo "(* = current task)"
    exit 0
    ;;
esac

resolve_task() {
  if [ -n "${1:-}" ]; then
    printf '%s' "$1"
  elif [ -f "$AGENTS_DIR/tasks/.current" ]; then
    tr -d '[:space:]' < "$AGENTS_DIR/tasks/.current"
  fi
}

TASK_ID=$(resolve_task "${1:-}")
if [ -z "$TASK_ID" ]; then
  echo "error: no task id given and .agents/tasks/.current is empty" >&2
  exit 2
fi
case "$TASK_ID" in
  .*|*[!A-Za-z0-9._-]*)
    echo "error: invalid task id '$TASK_ID'" >&2; exit 2 ;;
esac

TASK_DIR="$AGENTS_DIR/tasks/$TASK_ID"
if [ ! -d "$TASK_DIR" ]; then
  echo "error: task $TASK_ID not found at $TASK_DIR" >&2
  exit 1
fi

sep() { printf '\n========== %s ==========\n\n' "$1"; }

sep "progress.md ($TASK_ID)"
cat "$TASK_DIR/progress.md" 2>/dev/null || echo "(missing progress.md)"

sep "task.md (frontmatter + Goal)"
if [ -f "$TASK_DIR/task.md" ]; then
  awk '
    NR==1 && $0=="---" { fm=1; print; next }
    fm && /^---[[:space:]]*$/ { fm=0; print; next }
    fm { print; next }
    /^## Goal/ { g=1; print; next }
    g && /^## /  { exit }
    g { print }
  ' "$TASK_DIR/task.md"
  echo "(full logical document: $TASK_DIR/task.md)"
else
  echo "(missing task.md)"
fi
