#!/usr/bin/env bash
# agent-models-sync — regenerate native subagent adapters from config.yml.
# Run this after editing .agents/project/config.yml (models.agents / models.mapping):
# it rewrites .claude/agents/ and .opencode/agent/ and prints the Codex profile recipe.
# install.sh / update.sh call this same script, so there is one generator.
set -eu

case "${1:-}" in
  -h|--help)
    echo "Usage: agent-models-sync"
    echo "Regenerates .claude/agents/ and .opencode/agent/ adapters from"
    echo ".agents/project/config.yml, and prints the Codex profile recipe."
    echo "Run it after editing config.yml tiers/mapping."
    exit 0 ;;
esac

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
AGENTS_DIR=$(dirname "$SCRIPT_DIR")
DEST=$(dirname "$AGENTS_DIR")

AGENTS="$AGENTS_DIR/agents"
CFG="$AGENTS_DIR/project/config.yml"
[ -d "$AGENTS" ] || { echo "error: $AGENTS not found" >&2; exit 1; }
[ -f "$CFG" ]   || { echo "error: $CFG not found" >&2; exit 1; }

CLAUDE="$DEST/.claude/agents"
OPENCODE="$DEST/.opencode/agent"
mkdir -p "$CLAUDE" "$OPENCODE"

# tier|effort of an agent from models.agents inline object
agent_field() {
  grep -E "^[[:space:]]*$1:[[:space:]]*\{" "$CFG" | head -1 \
    | sed -nE "s/.*$2:[[:space:]]*([A-Za-z]+).*/\1/p"
}
# concrete model for (tier, cli) from models.mapping inline object
model_for() {
  grep -E "^[[:space:]]*$1:[[:space:]]*\{" "$CFG" | head -1 \
    | sed -E "s/.*[{,][[:space:]]*$2:[[:space:]]*([^,}]+).*/\1/" | tr -d ' '
}
# first non-empty line under "## Role" as a description
role_desc() {
  awk '/^## Role/{getline; gsub(/^[[:space:]]+/,""); if($0!=""){print; exit}}' "$1"
}

for f in "$AGENTS"/*.md; do
  [ -f "$f" ] || continue
  agent=$(basename "$f" .md)
  tier=$(agent_field "$agent" tier);   [ -n "$tier" ]   || tier=standard
  effort=$(agent_field "$agent" effort); [ -n "$effort" ] || effort=medium
  cm=$(model_for "$tier" claude-code)
  om=$(model_for "$tier" opencode)
  desc=$(role_desc "$f"); [ -n "$desc" ] || desc="$agent agent"
  gen="<!-- GENERATED — do not edit; edit .agents/agents/$agent.md and config.yml, then run agent-models-sync -->"

  {
    echo "---"
    echo "name: $agent"
    echo "description: $desc (see .agents/agents/$agent.md)"
    echo "model: ${cm:-inherit}"
    echo "---"
    echo "$gen"
    echo ""
    echo "Role: see \`.agents/agents/$agent.md\`. Protocol: follow \`AGENTS.md\`."
    echo "Tier: $tier · effort: $effort."
  } > "$CLAUDE/$agent.md"

  {
    echo "---"
    echo "description: $desc (see .agents/agents/$agent.md)"
    echo "model: ${om:-<provider/model>}"
    echo "---"
    echo "$gen"
    echo ""
    echo "Role: see \`.agents/agents/$agent.md\`. Protocol: follow \`AGENTS.md\`."
    echo "Tier: $tier · effort: $effort."
  } > "$OPENCODE/$agent.md"
done

# Prune generated adapters whose agent no longer exists (e.g. a renamed/removed role).
# Only removes files carrying the GENERATED marker — never user-authored subagents.
for dir in "$CLAUDE" "$OPENCODE"; do
  for a in "$dir"/*.md; do
    [ -f "$a" ] || continue
    name=$(basename "$a" .md)
    if [ ! -f "$AGENTS/$name.md" ] && grep -q 'GENERATED — do not edit' "$a"; then
      rm -f "$a"
    fi
  done
done

echo "Regenerated adapters from config.yml: .claude/agents/ and .opencode/agent/."

# --- slash commands: thin wrappers around the canonical prompts -------------
# Generated for Claude Code (.claude/commands/) and OpenCode (.opencode/command/);
# Codex users get a per-user prompts recipe printed below. Same GENERATED marker
# and prune rules as the agent adapters.
CLAUDE_CMDS="$DEST/.claude/commands"
OPENCODE_CMDS="$DEST/.opencode/command"
mkdir -p "$CLAUDE_CMDS" "$OPENCODE_CMDS"

emit_command() {
  name="$1"; desc="$2"; body="$3"
  for dir in "$CLAUDE_CMDS" "$OPENCODE_CMDS"; do
    {
      echo "---"
      echo "description: $desc"
      echo "---"
      echo "<!-- GENERATED — do not edit; edit agent-models-sync in the framework -->"
      echo ""
      echo "$body"
    } > "$dir/$name.md"
  done
}

emit_command task-new "Start a new task (intake interview) in the persistent agent system" \
  'Start a new task using the persistent agent system. $ARGUMENTS'
emit_command task-continue "Continue the current task from its persisted state" \
  'Continue the current task using the persistent agent system. $ARGUMENTS'
emit_command task-status "Show state, next step and recent log of the current task" \
  'Run `.agents/scripts/agent-task-status $ARGUMENTS` and report its output briefly. Do not read other task files.'
emit_command orchestrate "Run the task pipeline until the next human gate, dispatching subagents" \
  'Orchestrate the current task using the persistent agent system. $ARGUMENTS'
emit_command task-step "Run only the next phase of the task as a subagent, then stop" \
  'Run only the next phase of the current task using the persistent agent system: apply the orchestrating-agents skill in step mode — dispatch that single phase as a subagent with its adapter model, integrate the result, report what ran and what comes next, then stop. $ARGUMENTS'

# Prune generated commands whose definition no longer exists upstream.
for dir in "$CLAUDE_CMDS" "$OPENCODE_CMDS"; do
  for c in "$dir"/*.md; do
    [ -f "$c" ] || continue
    name=$(basename "$c" .md)
    case "$name" in task-new|task-continue|task-status|task-step|orchestrate) continue ;; esac
    grep -q 'GENERATED — do not edit' "$c" && rm -f "$c"
  done
done

echo "Regenerated slash commands: .claude/commands/ and .opencode/command/ (task-new, task-continue, task-status, task-step, orchestrate)."

# Codex config is per-user (not per-repo) — print the recipe to apply by hand.
echo ""
echo "Codex (per-user) — add/update these profiles in ~/.codex/config.toml:"
echo "----------------------------------------------------------------------"
printf '[profiles.reasoning]\nmodel = "%s"\nmodel_reasoning_effort = "high"\n\n'   "$(model_for reasoning codex)"
printf '[profiles.standard]\nmodel = "%s"\nmodel_reasoning_effort = "medium"\n\n' "$(model_for standard codex)"
printf '[profiles.fast]\nmodel = "%s"\nmodel_reasoning_effort = "low"\n'          "$(model_for fast codex)"
echo "----------------------------------------------------------------------"

echo ""
echo "Codex (per-user) — optional custom prompts in ~/.codex/prompts/:"
echo "----------------------------------------------------------------------"
echo "task-new.md:      Start a new task using the persistent agent system."
echo "task-continue.md: Continue the current task using the persistent agent system."
echo "orchestrate.md:   Orchestrate the current task using the persistent agent system."
echo "----------------------------------------------------------------------"
