#!/usr/bin/env bash
# agent-models-sync — regenerate native Claude Code subagent adapters from config.yml.
# Run this after editing .agents/project/config.yml (models.agents / models.mapping):
# it rewrites .claude/agents/. Claude Code is the only actively maintained CLI target
# right now; OpenCode/Codex mapping columns stay in config.yml for a future re-enable
# but are no longer generated (see AGENTS.md "Agent model tiers").
# install.sh / update.sh call this same script, so there is one generator.
set -eu

case "${1:-}" in
  -h|--help)
    echo "Usage: agent-models-sync"
    echo "Regenerates .claude/agents/ adapters from .agents/project/config.yml."
    echo "Run it after editing config.yml tiers/mapping."
    exit 0 ;;
esac

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
AGENTS_DIR=$(dirname "$SCRIPT_DIR")
DEST=$(dirname "$AGENTS_DIR")

AGENTS="$AGENTS_DIR/agents"
CFG="$AGENTS_DIR/project/config.yml"
[ -d "$AGENTS" ] || { echo "error: $AGENTS not found" >&2; exit 1; }
[ -f "$CFG" ]   || { echo "error: $CFG not found" >&2; exit 1; }

CLAUDE="$DEST/.claude/agents"
mkdir -p "$CLAUDE"

# tier|effort of an agent from models.agents inline object
agent_field() {
  grep -E "^[[:space:]]*$1:[[:space:]]*\{" "$CFG" | head -1 \
    | sed -nE "s/.*$2:[[:space:]]*([A-Za-z]+).*/\1/p"
}
# concrete model for (tier, cli) from models.mapping inline object
model_for() {
  grep -E "^[[:space:]]*$1:[[:space:]]*\{" "$CFG" | head -1 \
    | sed -E "s/.*[{,][[:space:]]*$2:[[:space:]]*([^,}]+).*/\1/" | tr -d ' '
}
# first non-empty line under "## Role" as a description
role_desc() {
  awk '/^## Role/{getline; gsub(/^[[:space:]]+/,""); if($0!=""){print; exit}}' "$1"
}

MISSING_TIERS=""
for f in "$AGENTS"/*.md; do
  [ -f "$f" ] || continue
  agent=$(basename "$f" .md)
  tier=$(agent_field "$agent" tier)
  if [ -z "$tier" ]; then
    tier=standard
    MISSING_TIERS="$MISSING_TIERS $agent"
  fi
  effort=$(agent_field "$agent" effort); [ -n "$effort" ] || effort=medium
  cm=$(model_for "$tier" claude-code)
  desc=$(role_desc "$f"); [ -n "$desc" ] || desc="$agent agent"
  gen="<!-- GENERATED — do not edit; edit .agents/agents/$agent.md and config.yml, then run agent-models-sync -->"

  # Only the orchestrator may dispatch subagents (nested orchestration, layer 1).
  # Every phase agent gets Agent denied so it can never spawn a layer of its own,
  # even when dispatched directly from the main session.
  {
    echo "---"
    echo "name: $agent"
    echo "description: $desc (see .agents/agents/$agent.md)"
    echo "model: ${cm:-inherit}"
    [ "$agent" != "orchestrator" ] && echo "disallowedTools: Agent"
    echo "---"
    echo "$gen"
    echo ""
    echo "Role: see \`.agents/agents/$agent.md\`. Protocol: follow \`AGENTS.md\`."
    echo "Tier: $tier · effort: $effort."
  } > "$CLAUDE/$agent.md"
done

# Prune generated adapters whose agent no longer exists (e.g. a renamed/removed role).
# Only removes files carrying the GENERATED marker — never user-authored subagents.
for a in "$CLAUDE"/*.md; do
  [ -f "$a" ] || continue
  name=$(basename "$a" .md)
  if [ ! -f "$AGENTS/$name.md" ] && grep -q 'GENERATED — do not edit' "$a"; then
    rm -f "$a"
  fi
done

# Remove any adapters previously generated for CLIs we no longer maintain (OpenCode,
# Codex). Only removes GENERATED-marked files — never user-authored content.
for dir in "$DEST/.opencode/agent" "$DEST/.opencode/command"; do
  [ -d "$dir" ] || continue
  for a in "$dir"/*.md; do
    [ -f "$a" ] || continue
    grep -q 'GENERATED — do not edit' "$a" && rm -f "$a"
  done
  rmdir "$dir" 2>/dev/null || true
done
rmdir "$DEST/.opencode" 2>/dev/null || true

echo "Regenerated adapters from config.yml: .claude/agents/ (Claude Code only — see AGENTS.md)."

if [ -n "$MISSING_TIERS" ]; then
  echo "" >&2
  echo "WARN: these agents have NO entry in models.agents of $CFG:" >&2
  for a in $MISSING_TIERS; do echo "  - $a (defaulted to standard/medium)" >&2; done
  echo "A silent default can put a cheap role (e.g. orchestrator) on an expensive" >&2
  echo "model. Add the missing entries — see project-template/config.yml in the" >&2
  echo "framework for the recommended tiers — then re-run agent-models-sync." >&2
fi

# --- slash commands: thin wrappers around the canonical prompts -------------
# Generated for Claude Code (.claude/commands/) only right now. Same GENERATED marker
# and prune rules as the agent adapters.
CLAUDE_CMDS="$DEST/.claude/commands"
mkdir -p "$CLAUDE_CMDS"

emit_command() {
  name="$1"; desc="$2"; body="$3"
  for dir in "$CLAUDE_CMDS"; do
    {
      echo "---"
      echo "description: $desc"
      echo "---"
      echo "<!-- GENERATED — do not edit; edit agent-models-sync in the framework -->"
      echo ""
      echo "$body"
    } > "$dir/$name.md"
  done
}

emit_command task "Advance the current task until the next human gate (subcommands — step | status | change | stop after <phase>)" \
  'Advance the current task using the persistent agent system. Route on the arguments — "$ARGUMENTS":

- (empty) → run the pipeline until the next human gate.
- `status` → run `.agents/scripts/agent-task-status`, report briefly, and name the exact command that comes next. Do not read other task files.
- `step` → run exactly ONE phase, then stop and hand back.
- `stop after <phase>` → run until that phase completes, then stop.
- `change <description>` → mid-task definition change: handle it in THIS session (never inside the orchestrator). Log it in task.md "Evolution & human decisions"; update the spec/plan if affected (re-run the approval gate if acceptance criteria moved); rewind progress.md phase/`## Next` to the earliest affected phase. Confirm the rewind with the human before writing it.

Execution model (all routes except `status` and `change`): if `.agents/current-task` is empty or missing, run the intake interview in this session first. If the current phase is interactive (intake, specifier), hold that conversation in this session. Otherwise check progress.md frontmatter `type`: for `chore`/`fix` (short-circuit — see orchestrating-agents skill), dispatch the current phase agent (implementer/reviewer) DIRECTLY from this session — no orchestrator — and run the dispatch/integrate loop yourself, honoring the requested granularity, until a gate or DONE. For `feature`/multi-phase `spike`/`debug`, dispatch the `orchestrator` subagent instead — fresh, with no session history; it reads all state from `.agents/tasks/<id>/` and returns at gates. Pass it only: the task id, the granularity (until-gate | one-phase | stop-after <phase>), and the instruction to follow the orchestrating-agents skill. When it returns, relay its report: what ran, what it is waiting on, and that `/task` resumes. If this CLI cannot dispatch subagents, apply the orchestrating-agents skill manual fallback instead.'

# Prune generated commands whose definition no longer exists upstream (this removes
# the pre-1.x commands: task-new, task-continue, task-status, task-step, orchestrate).
for c in "$CLAUDE_CMDS"/*.md; do
  [ -f "$c" ] || continue
  name=$(basename "$c" .md)
  case "$name" in task) continue ;; esac
  grep -q 'GENERATED — do not edit' "$c" && rm -f "$c"
done

echo "Regenerated slash commands: .claude/commands/ (task — with step | status | change | stop-after routes)."
echo ""
echo "Note: OpenCode/Codex adapter generation is currently paused (Claude Code is the"
echo "only actively maintained CLI). The mapping columns stay in config.yml — re-enable"
echo "by restoring the OpenCode/Codex generation block in this script if needed again."
