{
  "includeCoAuthoredBy": false,
  "permissions": {
    "deny": [
      "Bash(git commit --amend:*)",
      "Bash(git filter-branch:*)",
      "Bash(git push)",
      "Bash(git push:*)",
      "Bash(git rebase)",
      "Bash(git rebase:*)",
      "Bash(git reset --hard:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.agents/scripts/agent-git-guard"
          }
        ]
      }
    ]
  }
}
